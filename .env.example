# ---- required: one model provider -------------------------------------
# litellm picks the provider from the model string; set the matching key.
ANTHROPIC_API_KEY=sk-ant-...

# ---- sources ----------------------------------------------------------
# github  works with no key (60 req/hr). A token raises it to 5000/hr.
GITHUB_TOKEN=ghp_...
# hn      needs nothing at all.
# reddit  https://www.reddit.com/prefs/apps -> "script" app. No anonymous path exists.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# twitter PAID. X developer portal -> app-only bearer. The only source that costs money.
TWITTER_BEARER_TOKEN=

# ---- discord ----------------------------------------------------------
DISCORD_BOT_TOKEN=
# Optional: where the bot reads the digest from (default: ./out)
# SQUIDWARD_OUT_DIR=/var/lib/squidward

# ---- model selection (optional) ---------------------------------------
# SQUIDWARD_SCORER_MODEL=anthropic/claude-haiku-4-5
# SQUIDWARD_GROUPER_MODEL=anthropic/claude-opus-5
